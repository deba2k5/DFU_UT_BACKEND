# Copy to .env (or set in your host's dashboard). Never commit real keys.

# Bearer token the Flutter app must send. Empty = auth disabled (development only).
API_KEY=change-me-to-a-long-random-string

# Optional: path to a specific checkpoint. Default = newest .pth in ./weights
# MODEL_PATH=weights/utnet_b0_v1_fp16.pth

TORCH_THREADS=2

# Optional LLM report. With no key, a fixed template report is used.
# ANTHROPIC_API_KEY=sk-ant-...
# REPORT_LLM=auto            # auto | on | off
# REPORT_MODEL=claude-opus-5-5
# REPORT_TIMEOUT=10
