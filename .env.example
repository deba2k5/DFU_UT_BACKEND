# Copy to .env locally, or set these in your host's dashboard. Never commit real values.

# Signs login tokens. REQUIRED on Vercel/multi-instance hosts (same value everywhere).
SECRET_KEY=change-me-to-a-long-random-string

# First account, created only when the database has no users.
SEED_EMAIL=doctor1@gmail.com
SEED_PASSWORD=change-me
# SEED_NAME=Doctor 1

# Where the SQLite database and photos are stored (use a persistent disk in production).
# DATA_DIR=/srv/data

# Optional: a specific model file (default: newest weights/*.onnx)
# MODEL_PATH=weights/utnet_b0_v1.onnx
MODEL_THREADS=2

# Optional AI-written summary (falls back to a fixed template without a key).
# ANTHROPIC_API_KEY=sk-ant-...
# REPORT_LLM=auto            # auto | on | off
# REPORT_MODEL=claude-opus-5-5

# Allow a hosted Flutter web app to call the API.
# CORS_ORIGINS=https://your-web-app.example.org
