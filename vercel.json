{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{app/**,weights/*.onnx}",
      "excludeFiles": "{weights/*.pth,tests/**,tools/**,data/**}",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
